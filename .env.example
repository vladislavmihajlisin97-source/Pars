# Скопіюйте цей файл у .env та заповніть своїми даними:
#   cp .env.example .env
#
# api_id / api_hash отримуються тут: https://my.telegram.org
# (Applications -> Create new application)

TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Назва файлу сесії (створюється після першого входу). Необовʼязково.
TELEGRAM_SESSION=pars

# Проксі у форматі scheme://host:port — необовʼязково.
# Підтримуються socks4, socks5, http. Наприклад: socks5://127.0.0.1:9050
# TELEGRAM_PROXY=socks5://127.0.0.1:9050
